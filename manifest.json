{
  "manifest_version": 2,
  "name": "Jump to Noise",
  "version": "1.0.0",
  "description": "Jump to the currently playing tab with a hotkey. Cycles through multiple playing tabs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jump-to-noise@local",
      "strict_min_version": "79.0",
      "data_collection_permissions": {
        "personal_data_collected": false,
        "technical_data_collected": false
      }
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "permissions": [
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "commands": {
    "jump-to-noise": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Jump to playing tab"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
